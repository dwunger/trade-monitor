# ===========================================
# API Keys
# ===========================================
ANTHROPIC_API_KEY=sk-...  # REQUIRED: Get from https://console.anthropic.com

# Legacy OpenAI (not used anymore, but kept for reference)
# OPENAI_API_KEY=sk-...

# ===========================================
# Model Selection
# ===========================================
# Primary model for fast analysis (Sonnet 4.5 is fastest, cheapest)
MODEL=claude-sonnet-4-5-20250929

# Reasoning model for low-confidence posts (Sonnet 4 with extended thinking)
REASONING_MODEL=claude-sonnet-4-20250514

# Confidence threshold for escalating to reasoning model (0.0-1.0)
REASONING_TRIGGER_CONF=0.50

# Fallback models if primary models unavailable
REASONING_FALLBACK_1=claude-sonnet-4-20250514
REASONING_FALLBACK_2=claude-sonnet-3-7-20250219
REASONING_FALLBACK_3=claude-haiku-4-5-20251001

# ===========================================
# Extended Thinking (Macro Analysis Only)
# ===========================================
# Enable extended thinking for BLS economic reports (CPI/PPI/NFP)
EXT_THINKING_ENABLED=true
EXT_THINKING_BUDGET_TOKENS=8000
EXT_THINKING_MAX_TOKENS=16000

# ===========================================
# Pushover Notifications
# ===========================================
PUSHOVER_USER_KEY=...
PUSHOVER_API_TOKEN=...

# ===========================================
# Truth Social Monitor
# ===========================================
TRUTH_HANDLE=realDonaldTrump
POLL_SECONDS=90

# Enable Haiku screening (filters out non-market posts before expensive analysis)
# Saves ~70% on API costs by skipping irrelevant posts
TRUTH_SOCIAL_ENABLE_HAIKU_SCREENING=1
TRUTH_SOCIAL_SCREENING_MODEL=claude-haiku-4-5-20251001
TRUTH_SOCIAL_POLL_SECONDS=90

# Optional: Send heartbeat notifications
# TRUTH_SOCIAL_HEARTBEAT_SEC=3600
# TRUTH_SOCIAL_HEARTBEAT_PUSH=0

# ===========================================
# TACO Monitor (Trump Always Chickens Out)
# ===========================================
# Monitors: truth_social,taco,bls_rss,example
ENABLED_MONITORS=truth_social,taco

# Truth Social handle to monitor (defaults to TRUTH_HANDLE if not set)
# TACO_HANDLE=realDonaldTrump

# Polling frequency for TACO monitor (in seconds)
TACO_POLL_SECONDS=90

# Screening model (cheap Haiku for intelligent filtering)
TACO_SCREENING_MODEL=claude-haiku-4-5-20251001

# ===========================================
# BLS RSS Monitor (Optional)
# ===========================================
# Add 'bls_rss' to ENABLED_MONITORS to enable
# Monitors CPI, PPI, NFP releases for treasury trading signals

# Force check on startup (useful for testing)
# BLS_FORCE_STARTUP_RUN=false

# ===========================================
# Trading Settings
# ===========================================
# Optional: Restrict trade signals to specific tickers
# TICKER_WHITELIST=AAPL,MSFT,GOOG,TLT,SPY

# Rate limiting: Delay between processing posts (prevents bursts)
POST_PROCESS_DELAY=2.0

# Caps browsing/search cost (web_search tool)
MAX_SEARCH_CALLS_PER_DAY=100

# ===========================================
# Search Filters (Optional)
# ===========================================
# Limit web searches to specific domains
# SEARCH_FILTERS=sec.gov,reuters.com,bloomberg.com

# Localize search results
# LOCATION_COUNTRY=US
# LOCATION_CITY=Chambersburg
# LOCATION_REGION=PA
# LOCATION_TZ=America/New_York

# ===========================================
# Monitor Feed System (Optional Dashboard)
# ===========================================
# Enable structured logging for real-time dashboard
ENABLE_MONITOR_FEEDS=true

# Database location for monitor feeds
# MONITOR_FEEDS_DB=.monitor_feeds.db

# To view dashboard: python gui_feed_viewer.py

# ===========================================
# State & Timeout Settings
# ===========================================
STATE_FILE=.truth_trader_state.json
PUBLISH_TIMEOUT_SEC=25

# ===========================================
# TruthBrush Settings (Advanced - Not Required)
# ===========================================
# TruthBrush CLI can be used instead of public API
# Only needed if you hit rate limits on public endpoint

DEBUG_TRUTHBRUSH=0
USE_TRUTHBRUSH=0
TRUTHBRUSH_COOLDOWN_SECONDS=300
BOOTSTRAP_PAUSE_SECONDS=10

# Only needed if USE_TRUTHBRUSH=1
# TRUTHSOCIAL_USERNAME=...
# TRUTHSOCIAL_PASSWORD=...